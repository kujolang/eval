# Quality test suite — fuzz, property-based, and pipeline integration tests.

test_setup {
	from src.common import dict_get_or
	from src.config import validate_config
	from src.eval_core import run_suite
}

# ===========================================================================
# P4.1: Fuzz tests for config parser
# ===========================================================================

test "fuzz: validate_config handles deeply nested but valid config" {
	cfg := {
		"name": "deep",
		"tests": [
			{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}},
			{"name": "t2", "check": "command_succeeds", "params": {"command": "echo hi"}},
			{"name": "t3", "check": "output_contains", "params": {"command": "echo hello", "expected": "hello"}},
			{"name": "t4", "check": "file_contains", "params": {"path": "kennel.toml", "expected": "package"}},
			{"name": "t5", "check": "json_matches_shape", "params": {"path": "kennel.toml", "required_keys": ["package"]}}
		]
	}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

test "fuzz: validate_config handles config with extra unknown fields" {
	cfg := {
		"name": "unknown-fields",
		"random_field": 42,
		"another": [1, 2, 3],
		"tests": [{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}}]
	}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

test "fuzz: validate_config handles test with extra unknown fields" {
	cfg := {
		"name": "extra-test-fields",
		"tests": [{"name": "t1", "check": "file_exists", "params": {"path": "kennel.toml"}, "custom_field": "ignored", "another_field": 99}]
	}
	result := validate_config(cfg)
	assert_true(result["ok"])
}

# ===========================================================================
# P4.2: Cross-module pipeline integration test
# ===========================================================================

test "integration: run pipeline feeds every report contract" {
	try { write_file(".eval_integ_test.json", "{\"name\":\"integ\",\"tests\":[{\"name\":\"t1\",\"check\":\"file_exists\",\"params\":{\"path\":\"kennel.toml\"}}]}") } except err {}

	results := run_suite(".eval_integ_test.json", {"quiet": true})
	assert_true(results["ok"])
	data := dict_get_or(results, "data", {})
	assert_equal(dict_get_or(data, "total", 0), 1)

	from src.report import generate_markdown_report, generate_html_report, generate_junit_report, generate_tap_report
	rd := dict_get_or(results, "data", results)
	md := generate_markdown_report(rd)
	html := generate_html_report(rd)
	junit := generate_junit_report(rd)
	tap := generate_tap_report(rd)

	assert_true(contains(md, "integ") == 1)
	assert_true(contains(html, "<title>Eval Report: integ</title>") == 1)
	assert_true(contains(junit, "<testsuite name=\"integ\" tests=\"1\"") == 1)
	assert_true(contains(tap, "1..1") == 1)
	assert_true(contains(tap, "ok 1 - t1") == 1)

	try { remove_file(".eval_integ_test.json") } except err {}
}
